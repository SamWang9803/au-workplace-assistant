# Copy this file to .env and fill in OPENAI_API_KEY.
# Every other value below is a working default from docs/design/2026-11-02-fairwork-rag-design.md.

# OpenAI key. Used for chat answers, the eval judge and embeddings.
OPENAI_API_KEY=

# Chat model for answers and the eval judge (temperature 0 + strict JSON schema).
CHAT_MODEL=gpt-4.1-mini

# Embedding model (1536 dimensions, must match vector(1536) in the schema).
EMBED_MODEL=text-embedding-3-small

# PostgreSQL 16 + pgvector from docker-compose.yml. Port 5433 avoids a local 5432.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Refuse when the best cosine similarity of the retrieved chunks is below this.
RAG_MIN_SIMILARITY=0.30
