# Copy this file to .env and fill in GEMINI_API_KEY. Every other value below is a
# working default from docs/design/2026-11-02-fairwork-rag-design.md.

# Google AI Studio key (free tier). Used for chat answers, the eval judge and embeddings.
GEMINI_API_KEY=

# Gemini's OpenAI-compatible endpoint. Both the chat and embedding clients use it.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Chat model for answers and the eval judge.
CHAT_MODEL=gemini-2.5-flash

# Embedding model. Requested at 1536 dimensions to match vector(1536) in the schema.
EMBED_MODEL=gemini-embedding-2

# PostgreSQL 16 + pgvector from docker-compose.yml. Port 5433 avoids a local 5432.
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Refuse when the best cosine similarity of the retrieved chunks is below this.
RAG_MIN_SIMILARITY=0.30

# Minimum seconds between chat calls (Gemini free tier allows roughly 5-10 requests/min).
CHAT_MIN_INTERVAL_S=7
